# JESUS CHRIST, A CALCULATOR!!! #

import "../math.sus"
import "../input.sus"

a = inputNumber();
op = inputOperator();

if(op == "!") -> 
    println(string(a) + op + " = " + fact(a));
else
{
    b = inputNumber();

    print(string(a) + " " + op + " " + b + " = ");

    if    (op == "+") -> println(a + b);
    elseif(op == "-") -> println(a - b);
    elseif(op == "*") -> println(a * b);
    elseif(op == "/") -> println(a / b);

    else -> println("Error: unknown operation.");
}
